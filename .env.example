# Environment Variables

# REST API (Laravel) - data source and auth
VITE_API_URL=https://ng-api.krugerdavid.com

# Sentry (monitoreo de errores) — dejar vacío en local; cargar el DSN real solo en Netlify
VITE_SENTRY_DSN=

# Sentry — subida de sourcemaps en el build (sin prefijo VITE_ a propósito: solo se usan
# en build time, nunca llegan al bundle del navegador). Vacío en local, cargar en Netlify.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
